<?xml version="1.0"?>
<package format="3">
  <name>path_planner</name>
  <version>0.0.0</version>
  <description>Minimal ROS 2 path planner plugin shell for phased migration.</description>

  <maintainer email="913982779@qq.com">winter</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>common</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/path_planner_plugin.xml" />
  </export>
</package>
